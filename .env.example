# ── Runtime ──────────────────────────────────────────────────────────
NODE_ENV=development
PLATFORM_API_HOST=127.0.0.1
PLATFORM_API_PORT=7010
PLATFORM_API_URL=http://127.0.0.1:7010
PLATFORM_WEB_HOST=127.0.0.1
PLATFORM_WEB_ALLOWED_HOSTS=localhost,app.codexsun.test
PLATFORM_WEB_PORT=7020
PLATFORM_WEB_ORIGIN=http://app.codexsun.test
PLATFORM_WEB_ORIGINS=

# ── Database ─────────────────────────────────────────────────────────
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_MASTER_NAME=

# Database lifecycle.
# CODEXSUN_DB_FRESH_ON_START=1 drops and rebuilds configured databases on API startup.
# Destructive actions require CODEXSUN_DB_RESET_CONFIRM=DROP_DATABASES.
# Production additionally requires CODEXSUN_ALLOW_PRODUCTION_DB_RESET=1.
CODEXSUN_DB_FRESH_ON_START=0
CODEXSUN_DB_RESET_CONFIRM=
CODEXSUN_ALLOW_PRODUCTION_DB_RESET=0

# Database maintenance and queue-backed backup/restore.
CODEXSUN_BACKUP_DIR=storage/backups/database
CODEXSUN_RESTORE_TEST_DB_NAME=
CODEXSUN_VERIFIED_BACKUP_ID=
CODEXSUN_ALLOW_LIVE_RESTORE=0
CODEXSUN_LIVE_RESTORE_CONFIRM=

# Initial queue backend. Super Admin can switch at runtime between memory, database, and
# bullmq-redis. The selection is persisted in queue_runtime_settings.
CODEXSUN_QUEUE_BACKEND=database
CODEXSUN_REDIS_URL=redis://127.0.0.1:6379

# Default Mail fallback. Tenant company settings take priority when enabled.
MAIL_ENABLED=0
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=CODEXSUN
MAIL_REPLY_TO=
PASSWORD_RESET_TTL_MINUTES=30
CODEXSUN_QUEUE_WORKER_ENABLED=1
CODEXSUN_QUEUE_WORKER_INTERVAL_MS=5000
CODEXSUN_QUEUE_COMPLETED_RETENTION_DAYS=14
CODEXSUN_QUEUE_FAILED_RETENTION_DAYS=30

# Test-only default first tenant seed. Keep disabled for normal/live runtime.
# Set ENABLE_DEFAULT_TENANT_SEED=1 only for local smoke tests or e2e runs.
ENABLE_DEFAULT_TENANT_SEED=0
DEV_AUTO_TENANT_LOGIN=0
TENANT_DOMAIN_BASE=localhost
DEFAULT_TENANT_NAME=CODEXSUN
DEFAULT_TENANT_CORPORATE_ID=
DEFAULT_TENANT_SLUG=
DEFAULT_TENANT_DB_NAME=
DEFAULT_TENANT_DOMAIN=app.codexsun.test
DEFAULT_TENANT_ADMIN_NAME=
DEFAULT_TENANT_ADMIN_EMAIL=
DEFAULT_TENANT_ADMIN_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────────
# REQUIRED. No fallback.
JWT_SECRET=

# WhiteBooks GST provider. Keep all credentials server-side; never expose them as VITE_* values.
GSP_ENVIRONMENT=sandbox
GSP_SANDBOX_BASE_URL=https://apisandbox.whitebooks.in
GSP_BASE_URL=https://api.whitebooks.in
GSP_EMAIL=
GSP_USERNAME=
GSP_PASSWORD=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
GSP_GSTIN=
GSP_IP_ADDRESS=0.0.0.0

# Hybrid keeps browser sessions in an HttpOnly cookie while retaining bearer JWTs for API clients.
AUTH_MODE=hybrid
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_RENEWAL_HOURS=24

# ── Seed users (blank on live deployments) ───────────────────────────
# Optional first platform users. Leave blank on live and create users
# manually unless this deployment intentionally needs a seeded account.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

SOFTWARE_ADMIN_NAME=
SOFTWARE_ADMIN_EMAIL=
SOFTWARE_ADMIN_PASSWORD=

# Optional tenant setup helper account. Leave blank on live unless you
# intentionally want every newly setup tenant to receive this admin user.
TENANT_ADMIN_NAME=
TENANT_ADMIN_EMAIL=
TENANT_ADMIN_PASSWORD=

STORAGE_ROOT=storage/app
STORAGE_PUBLIC_ROOT=storage/public
TASK_MANAGER_JSON_DIR=storage/app/task-manager

# ── Dev / Tooling ────────────────────────────────────────────────────
# Set to "abort" to prevent the dev preflight from killing active listeners.
# CODEXSUN_DEV_PORT_POLICY=abort

# Set to 1 for faster local restarts when the database is already prepared.
# Skips the API database preflight and startup database bootstrap.
CODEXSUN_DEV_SKIP_DB=0

# Database safety command guards.
# Required for npm run db:migrations:test-local after restoring a dump locally.
CODEXSUN_RESTORED_DUMP_TEST=0

# Required for npm run db:backup:verify.
CODEXSUN_BACKUP_VERIFY_ID=

# Deployment and container settings (same root .env; no generated deployment env).
NODE_RUNTIME_VERSION=26.5.0
NPM_RUNTIME_VERSION=12.0.1
NGINX_BASE_IMAGE=nginx:1.28-alpine
CODEXSUN_VERSION=1.0.42
CODEXSUN_IMAGE_REGISTRY=codexsun
CODEXSUN_DOCKER_NETWORK=codexsun-network
CODEXSUN_BIND_ADDRESS=127.0.0.1
CODEXSUN_SINGLE_TENANT=1
MARIADB_BASE_IMAGE=mariadb:11.8
MARIADB_IMAGE_TAG=11.8-codexsun-1.0.42
MARIADB_CLIENT_PATH=mariadb
MARIADB_ADMIN_USER=root
MARIADB_ROOT_PASSWORD=change_this_mariadb_root_password
MARIADB_BIND_ADDRESS=127.0.0.1
MARIADB_HOST_PORT=3307
MARIADB_DATA_VOLUME=codexsun-mariadb-data
MARIADB_BACKUP_VOLUME=codexsun-mariadb-backups
REDIS_BASE_IMAGE=redis:7.4-alpine
REDIS_IMAGE_TAG=7.4-codexsun-1.0.42
REDIS_PASSWORD=change_this_redis_password
REDIS_HOST_PORT=6379
REDIS_DATA_VOLUME=codexsun-redis-data
FILEBROWSER_BASE_IMAGE=filebrowser/filebrowser:v2.63.5
MEDIA_IMAGE_TAG=1.0.42-filebrowser2.63.5
MEDIA_HOST_PORT=7090
MEDIA_ADMIN_USER=admin
MEDIA_ADMIN_PASSWORD=change_this_media_admin_password
MEDIA_DATA_VOLUME=codexsun-media-data
MEDIA_DB_VOLUME=codexsun-media-db
BILLING_STACK_API_IMAGE_TAG=1.0.42
BILLING_STACK_WEB_IMAGE_TAG=1.0.42
BILLING_STACK_MIGRATIONS_IMAGE_TAG=1.0.42
BILLING_STACK_DATA_VOLUME=codexsun-billing-stack-data
CODEXSUN_WEB_HOST=app.codexsun.com
CODEXSUN_WEB_HOST_ALT=www.codexsun.com
CODEXSUN_MEDIA_HOST=files.codexsun.com
