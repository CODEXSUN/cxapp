# === Production runtime ===
NODE_ENV=production
PLATFORM_API_PORT=17010
PLATFORM_WEB_PORT=17020
PLATFORM_WEB_ORIGIN=https://app.codexsun.com

# === Container database connection ===
DB_DRIVER=mariadb
DB_HOST=cxapp-mariadb
DB_PORT=3306
DB_USER=cxapp
DB_PASSWORD=change_this_database_password
DB_MASTER_NAME=cxapp_master_db

# --- Database lifecycle ---
CXAPP_DB_FRESH_ON_START=0
CXAPP_DB_RESET_CONFIRM=
CXAPP_ALLOW_PRODUCTION_DB_RESET=0

# --- Database maintenance and backup/restore ---
CXAPP_BACKUP_DIR=storage/backups/database
CXAPP_RESTORE_TEST_DB_NAME=
CXAPP_VERIFIED_BACKUP_ID=change_this_verified_backup_id
CXAPP_ALLOW_LIVE_RESTORE=0
CXAPP_LIVE_RESTORE_CONFIRM=

# === Queue and Redis ===
CXAPP_QUEUE_BACKEND=bullmq-redis
CXAPP_REDIS_URL=redis://cxapp-redis:6379/0

# === Mail fallback ===
MAIL_ENABLED=0
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=CODEXSUN
MAIL_REPLY_TO=
PASSWORD_RESET_TTL_MINUTES=30
CXAPP_QUEUE_WORKER_ENABLED=1
CXAPP_QUEUE_WORKER_INTERVAL_MS=5000
CXAPP_QUEUE_COMPLETED_RETENTION_DAYS=14
CXAPP_QUEUE_FAILED_RETENTION_DAYS=30

# === Default tenant ===
ENABLE_DEFAULT_TENANT_SEED=1
DEV_AUTO_TENANT_LOGIN=0
TENANT_DOMAIN_BASE=codexsun.com
DEFAULT_TENANT_NAME=CODEXSUN
DEFAULT_TENANT_CORPORATE_ID=CODEXSUN
DEFAULT_TENANT_SLUG=codexsun
DEFAULT_TENANT_DB_NAME=cxapp_db
DEFAULT_TENANT_DOMAIN=app.codexsun.com
DEFAULT_TENANT_ADMIN_NAME=
DEFAULT_TENANT_ADMIN_EMAIL=
DEFAULT_TENANT_ADMIN_PASSWORD=

# === Authentication and sessions ===
JWT_SECRET=change_this_jwt_secret
AUTH_MODE=hybrid
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_RENEWAL_HOURS=24

# === WhiteBooks GST provider ===
GSP_ENVIRONMENT=sandbox
GSP_SANDBOX_BASE_URL=https://apisandbox.whitebooks.in
GSP_BASE_URL=https://api.whitebooks.in
GSP_EMAIL=
GSP_USERNAME=
GSP_PASSWORD=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
GSP_GSTIN=
GSP_IP_ADDRESS=0.0.0.0

# === Bootstrap users ===
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

SOFTWARE_ADMIN_NAME=
SOFTWARE_ADMIN_EMAIL=
SOFTWARE_ADMIN_PASSWORD=

TENANT_ADMIN_NAME=
TENANT_ADMIN_EMAIL=
TENANT_ADMIN_PASSWORD=

# === Container storage paths ===
STORAGE_ROOT=storage/app
STORAGE_PUBLIC_ROOT=storage/public
TASK_MANAGER_JSON_DIR=storage/app/task-manager
CXAPP_DEVKIT_STORAGE_PATH=storage/app/devkit
CXAPP_DEVKIT_SYNC_ROLE=disabled
CXAPP_DEVKIT_SYNC_INSTANCE_ID=
CXAPP_DEVKIT_SYNC_TOKEN_PEPPER=
CXAPP_DEVKIT_SYNC_ENCRYPTION_KEY=
CXAPP_DEVKIT_SYNC_TEST_CLOUD_URL=
CXAPP_DEVKIT_WORKSPACE_ROOT=

# === Database tooling guards ===
CXAPP_DEV_SKIP_DB=0
CXAPP_RESTORED_DUMP_TEST=0
CXAPP_BACKUP_VERIFY_ID=

# === Deployment images and network ===
NODE_RUNTIME_VERSION=26.5.0
NPM_RUNTIME_VERSION=12.0.1
NGINX_BASE_IMAGE=nginx:1.28-alpine
CXAPP_VERSION=1.0.47
CXAPP_IMAGE_REGISTRY=cxapp
CXAPP_DOCKER_NETWORK=cxapp-network
CXAPP_BIND_ADDRESS=127.0.0.1
CXAPP_SINGLE_TENANT=1

# === MariaDB container ===
MARIADB_BASE_IMAGE=mariadb:11.8
MARIADB_IMAGE_TAG=11.8-cxapp-1.0.47
MARIADB_CLIENT_PATH=mariadb
MARIADB_ADMIN_USER=root
MARIADB_ROOT_PASSWORD=change_this_mariadb_root_password
MARIADB_BIND_ADDRESS=127.0.0.1
MARIADB_HOST_PORT=3307
MARIADB_DATA_VOLUME=cxapp-mariadb-data
MARIADB_BACKUP_VOLUME=cxapp-mariadb-backups

# === Redis container ===
REDIS_BASE_IMAGE=redis:7.4-alpine
REDIS_IMAGE_TAG=7.4-cxapp-1.0.45
REDIS_PASSWORD=change_this_redis_password
REDIS_HOST_PORT=6379
REDIS_DATA_VOLUME=cxapp-redis-data

# === File Browser container ===
FILEBROWSER_BASE_IMAGE=filebrowser/filebrowser:v2.63.5
MEDIA_IMAGE_TAG=1.0.47-filebrowser2.63.5
MEDIA_HOST_PORT=7090
MEDIA_ADMIN_USER=admin
MEDIA_ADMIN_PASSWORD=change_this_media_admin_password
MEDIA_DATA_VOLUME=cxapp-media-data
MEDIA_DB_VOLUME=cxapp-media-db

# === Application images and storage ===
BILLING_STACK_API_IMAGE_TAG=1.0.47
BILLING_STACK_WEB_IMAGE_TAG=1.0.47
BILLING_STACK_MIGRATIONS_IMAGE_TAG=1.0.47
BILLING_STACK_DATA_VOLUME=cxapp-billing-stack-data

# === Public deployment hosts ===
CXAPP_WEB_HOST=app.codexsun.com
CXAPP_WEB_HOST_ALT=www.codexsun.com
CXAPP_MEDIA_HOST=files.codexsun.com
